<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_xorel_gradient">

    <!-- Ambient glow orbs (static decorative layers behind scroll) -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-48dp"
        android:layout_marginEnd="-72dp"
        android:alpha="0.5"
        android:background="@drawable/bg_xorel_glow_orb" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contentColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Hero: logo + title -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_name"
                android:elevation="8dp"
                android:src="@drawable/ic_xorel_logo" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/xorel_text_primary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/xorel_tagline"
                android:textColor="@color/xorel_text_secondary"
                android:textSize="14sp" />

            <!-- License strip -->
            <FrameLayout
                android:id="@+id/cardLicense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_xorel_card"
                android:elevation="6dp"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="License"
                        android:textColor="@color/xorel_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/keyStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/key_checking"
                        android:textColor="@color/xorel_text_primary"
                        android:textSize="15sp"
                        tools:text="License active" />

                    <ProgressBar
                        android:id="@+id/keyProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="12dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/xorel_accent" />
                </LinearLayout>
            </FrameLayout>

            <!-- Actions -->
            <Button
                android:id="@+id/btnOverlay"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_xorel_button_outline"
                android:text="@string/btn_overlay_perm"
                android:textAllCaps="false"
                android:textColor="@color/xorel_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_xorel_button"
                android:enabled="false"
                android:text="@string/btn_start_overlay"
                android:textAllCaps="false"
                android:textColor="@color/xorel_bg_start"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEspStart"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_fab_esp_start"
                    android:enabled="false"
                    android:text="@string/btn_launch_start_esp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnEspStop"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_fab_esp_stop"
                    android:enabled="false"
                    android:text="@string/btn_launch_stop_esp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:minHeight="0dp"
                android:padding="12dp"
                android:text="@string/btn_open_game"
                android:textAllCaps="false"
                android:textColor="@color/xorel_accent" />

            <!-- Steps card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_xorel_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_steps_title"
                    android:textColor="@color/xorel_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="10dp"
                    android:text="@string/step_1"
                    android:textColor="@color/xorel_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/step_2"
                    android:textColor="@color/xorel_text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/step_3"
                    android:textColor="@color/xorel_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
